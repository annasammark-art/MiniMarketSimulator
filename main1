def product_button_text(product_name: str) -> str:
    product = products[product_name]
    difference = product["sell_price"] - product["competitor_price"]
    if difference > 0:
        comparison = f"Дороже на {difference} руб."
    elif difference < 0:
        comparison = f"Дешевле на {-difference} руб."
    else:
        comparison = "Цены равны"
    return (
        f"{product_name}\n"
        f"Закупка: {product["purchase_price"]} | Продажа: {product["sell_price"]}\n"
        f"Конкурент: {product["competitor_price"]} | {comparison}\n"
        f"На складе: {product["stock"]} уп."
    )

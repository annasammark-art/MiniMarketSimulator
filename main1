product_price = tk.StringVar(value = list(products.keys())[0])
def change_sell_price () -> None:
    product_name = product_price.get()
    product = products[product_name]
    new_price = simpledialog.askinteger(
        f"Изменение цены: \n",
        f"Введите цену продажи для {product_name}: \n"
        f"Текущая цена: {product["sell_price"]} \n",
        minvalue = product["purchase_price"] + 1,
        parent = window 
    )
    if new_price is None:
        return
    product["sell_price"] = new_price
    competitor_price = product["competitor_price"]
    if new_price > competitor_price:
        difference = new_price - competitor_price
        comparison = f"Наша цена выше на {difference} руб."
    elif new_price < competitor_price:
        difference = competitor_price - new_price
        comparison = f"Наша цена ниже на {difference} руб."
    else:
        comparison = f"Наши цены одинаковые."
    buttons[product_name].config(
        text=product_button_text(product_name)
    )
    messagebox.showinfo("Цена изменена",
                        f"Наша цена продажи: {new_price}\n"
                        f"Цена конкурента: {competitor_price}\n"
                        f"{comparison}")
